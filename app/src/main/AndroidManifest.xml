<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="MminoHub"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity android:name=".ArtistRegistrationActivity" android:exported="false" />
        <activity android:name=".ArtistIdentityVerificationActivity" android:exported="false" />
        <activity android:name=".ArtistProfileActivity" android:exported="false" />
        <activity android:name=".MusicUploadActivity" android:exported="false" />
        <activity android:name=".ReleaseManagementActivity" android:exported="false" />
        <activity android:name=".ArtistDashboardActivity" android:exported="false" />
        <activity android:name=".ArtistEarningsActivity" android:exported="false" />

        <activity android:name=".ListenerAuthActivity" android:exported="false" />
        <activity android:name=".ListenerProfileActivity" android:exported="false" />
        <activity android:name=".ListenerLibraryActivity" android:exported="false" />
        <activity android:name=".ListenerFollowingActivity" android:exported="false" />
        <activity android:name=".ListenerNotificationsActivity" android:exported="false" />
        <activity android:name=".ListenerPremiumActivity" android:exported="false" />
        <activity android:name=".ListenerPurchaseHistoryActivity" android:exported="false" />
        <activity android:name=".ListenerSupportActivity" android:exported="false" />

        <activity
            android:name=".MusicPlayerActivity"
            android:exported="false" />

        <activity
            android:name=".DiscoverActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service
            android:name=".MusicPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>